# Database (PostgreSQL) -- asosiy biznes ma'lumotlar (Groups, Students, Leaders va h.k.)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=your_db
DB_USERNAME=postgres
DB_PASSWORD=changeme

# Lokal SQLite -- faqat ai_reports va chats_last_check jadvallari shu yerda saqlanadi
LOCAL_SQLITE_PATH=local_data.sqlite3

# Telegram (Pyrogram)
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_SESSIONS_DIR=sessions

# AI (Google Gemini via LangChain)
GOOGLE_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3-flash-preview
AI_MAX_TOKENS=65536
AI_TEMPERATURE=0.2

# App
LOG_LEVEL=INFO
FETCH_DAYS_FALLBACK=14
FLOOD_WAIT_MAX_RETRIES=2